+    def invalid_prediction_reason(outputs):
+        """Return a short reason before invalid boxes reach the matcher.
+
+        DEIM predicts normalized cxcywh boxes.  Non-finite values or a
+        negative width/height make generalized_box_iou undefined.  Recovery
+        runs skip only such batches; they do not fabricate box values.
+        """
+        pred_boxes = outputs.get('pred_boxes')
+        if pred_boxes is None:
+            return 'missing_pred_boxes'
+        if not torch.isfinite(pred_boxes).all():
+            return f'nonfinite={int((~torch.isfinite(pred_boxes)).sum().item())}'
+        negative_wh = pred_boxes[..., 2:] < 0
+        if negative_wh.any():
+            return f'negative_wh={int(negative_wh.sum().item())}'
+        return None
